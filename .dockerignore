# Wheel build needs only pyproject.toml, README.md, and src/. Keep the build
# context small and cache-stable by excluding everything else.
.git
.gitlab-ci.yml
.dockerignore
.obsidian
.claude
.serena
openspec
specs
scripts
tests
dist
build
*.egg-info
__pycache__
*.pyc
.venv
.pytest_cache
.ruff_cache
node_modules
data
.env
uv.lock
