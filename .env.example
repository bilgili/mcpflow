# Password hash of the user `admin`. This variable owns that password: the process
# sets it at every start. Produce it with: mcpflow hash-password
# You can set ADMIN_PASSWORD (clear text) instead; the hash wins when both are set.
# At login, an empty user name means `admin`.
# Other users and the multi-user design: docs/multi-user-access.md
ADMIN_PASSWORD_HASH=
# Cookie signing key, 64 hex characters. Keep it secret and stable across restarts.
SECRET_KEY=
# Set to 1 when a TLS proxy terminates HTTPS in front of the gateway.
COOKIE_SECURE=0
