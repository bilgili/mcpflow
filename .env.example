# The admin password is not an environment variable. Run the command below as the
# server user (a run as root makes a file that the server cannot read), then restart:
#   docker compose exec mcpflow mcpflow set-admin-password
#   docker compose restart mcpflow
# ADMIN_PASSWORD and ADMIN_PASSWORD_HASH are ignored. The start logs a WARNING when one is set.
# At login, an empty user name means `admin`.
# Other users and the multi-user design: docs/multi-user-access.md
# Cookie signing key, 64 hex characters. Keep it secret and stable across restarts.
SECRET_KEY=
# Set to 1 when a TLS proxy terminates HTTPS in front of the gateway.
COOKIE_SECURE=0
