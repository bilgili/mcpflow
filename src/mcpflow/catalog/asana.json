{
  "id": "asana",
  "name": "Asana",
  "vendor": "Asana",
  "category": "projects",
  "color": "#f06a6a",
  "description": "Tasks, projects, and workspaces in Asana.",
  "auth": "oauth",
  "tools": [
    "asana_search_tasks",
    "asana_get_task",
    "asana_create_task",
    "asana_update_task",
    "asana_list_workspaces",
    "asana_get_project"
  ],
  "spec": {
    "kind": "remote",
    "url": "https://mcp.asana.com/sse",
    "transport": "sse"
  },
  "setup": [
    {
      "key": "Authorization",
      "where": "header",
      "hint": "Bearer <token>, when the vendor issues one",
      "required": false
    }
  ]
}
