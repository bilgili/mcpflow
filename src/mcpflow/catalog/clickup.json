{
  "id": "clickup",
  "name": "ClickUp",
  "vendor": "ClickUp",
  "category": "projects",
  "color": "#7b68ee",
  "description": "Tasks, lists, and spaces in a ClickUp workspace.",
  "auth": "env",
  "tools": [
    "get_workspace_hierarchy",
    "create_task",
    "get_task",
    "update_task",
    "get_workspace_tasks"
  ],
  "spec": {
    "kind": "npm",
    "package": "@taazkareem/clickup-mcp-server"
  },
  "setup": [
    {
      "key": "CLICKUP_API_KEY",
      "where": "env",
      "hint": "pk_... API token",
      "required": true
    },
    {
      "key": "CLICKUP_TEAM_ID",
      "where": "env",
      "hint": "workspace id",
      "required": true
    }
  ]
}
