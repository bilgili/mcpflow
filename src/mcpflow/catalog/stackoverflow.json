{
  "id": "stackoverflow",
  "name": "Stack Overflow",
  "vendor": "Stack Overflow",
  "category": "dev",
  "color": "#f48024",
  "description": "Search questions and answers on Stack Overflow.",
  "auth": "oauth",
  "tools": [
    "search",
    "get_question",
    "get_answers"
  ],
  "spec": {
    "kind": "remote",
    "url": "https://mcp.stackoverflow.com",
    "transport": "http"
  },
  "setup": [
    {
      "key": "Authorization",
      "where": "header",
      "hint": "Bearer <token>, when the vendor issues one",
      "required": false
    }
  ]
}
