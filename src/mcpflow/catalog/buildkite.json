{
  "id": "buildkite",
  "name": "Buildkite",
  "vendor": "Buildkite",
  "category": "dev",
  "color": "#14cc80",
  "description": "Pipelines, builds, and job logs in Buildkite.",
  "auth": "oauth",
  "tools": [
    "list_pipelines",
    "get_pipeline",
    "list_builds",
    "get_build",
    "get_job_logs"
  ],
  "spec": {
    "kind": "remote",
    "url": "https://mcp.buildkite.com/mcp",
    "transport": "http"
  },
  "setup": [
    {
      "key": "Authorization",
      "where": "header",
      "hint": "Bearer <token>, when the vendor issues one",
      "required": false
    }
  ]
}
